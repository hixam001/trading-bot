# Build context: the repo ROOT (this file builds the frontend too):
#   docker build -t trading-bot .
#   docker run --env-file .env -p 8000:8000 -v bot_state:/app/backend/live_execution/state trading-bot
.git
.venv
.env
.env.*
# Wallet key material and encrypted state archives must never enter the build
# context. The live service receives the keypair through a runtime bind mount
# (`WALLET_KEYPAIR_HOST_PATH`), and backups are written to the engine_backups
# volume — neither belongs in an image layer or the build cache.
secrets/
**/wallet_keypair*.json
*.enc
backups/
*.db
*.db-journal
*.db-wal
*.db-shm
**/__pycache__
**/*.py[cod]
.pytest_cache
.run
logs
.clinerules
memory-bank
docs
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
frontend/.env.local
backend/live_execution/state
backend/knowledge_base/ingested
# Runtime state that must never be baked into an image (stale blocklist /
# break state / ledgers would ship as if they were code).
backend/blocklist_state.json
**/*.corrupt
**/*.bak-dust
*.log
.coverage
htmlcov
.vscode
.idea