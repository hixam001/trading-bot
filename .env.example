# Operator-facing settings ONLY. Risk-critical constants (PAPER_TRADING_ONLY,
# SLIPPAGE_PCT, FEE_PCT) are hardcoded in config.py and deliberately NOT here.

# Data backend selection (A9): "mock" | "live"
DATA_BACKEND=mock

# --- External API keys -------------------------------------------------------
# Birdeye: REQUIRED for DATA_BACKEND=live (free-tier key from birdeye.so),
# sent as X-API-KEY.
BIRDEYE_API_KEY=
# Dexscreener: basic pair/search endpoints are currently keyless; field
# reserved for a future paid tier (sent as bearer token when set).
DEXSCREENER_API_KEY=
# Jupiter: quote API v6 is currently keyless; a Jupiter Pro key is sent as
# x-api-key when set.
JUPITER_API_KEY=

# Ollama
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3:8b

# Tick loop
TICK_INTERVAL_SECONDS=60
MAX_CANDIDATES_PER_TICK=20

# Portfolio
INITIAL_CASH_USD=1000.0

# Database (relative paths resolve against the repo root)
DB_PATH=trading_bot.db
