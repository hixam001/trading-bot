# =============================================================================
# .env.example — EVERY environment field the application reads, by section.
# Copy to .env and fill in the values. "MUST FILL" = the feature it powers is
# off/broken without it. Risk-critical constants (PAPER_TRADING_ONLY,
# SLIPPAGE_PCT, FEE_PCT, all rule/exit thresholds) are HARDCODED in config.py
# and deliberately NOT here.
# =============================================================================

# --- 1. CORE (must review) ----------------------------------------------------
# Data backend selection: "mock" | "live". MUST BE SET — "live" additionally
# requires BIRDEYE_API_KEY below.
DATA_BACKEND=mock
# Where the SQLite book lives (relative paths resolve against the repo root).
DB_PATH=trading_bot.db

# --- 2. EXTERNAL API KEYS (fill per feature) ----------------------------------
# Birdeye: MUST FILL for DATA_BACKEND=live. Free key from birdeye.so
# (sent as X-API-KEY).
BIRDEYE_API_KEY=
# Dexscreener: OPTIONAL — basic endpoints are currently keyless; reserved for
# a future paid tier (sent as bearer token when set).
DEXSCREENER_API_KEY=
# Jupiter: OPTIONAL — quote API is currently keyless; Pro key sent as
# x-api-key when set.
JUPITER_API_KEY=

# --- 3. MAIN LLM / GROQ (used for thesis and model analysis) -----------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_TOKENS=192

# Legacy local provider settings, retained for offline compatibility only.
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3:8b
# Optional: context window for generate calls (KV-cache RAM scales with it).
OLLAMA_NUM_CTX=1024

# --- 4. TICK LOOP (optional tuning; defaults shown) ---------------------------
TICK_INTERVAL_SECONDS=60
MAX_CANDIDATES_PER_TICK=20

# --- 5. PORTFOLIO & API SERVER (optional tuning; defaults shown) --------------
INITIAL_CASH_USD=1000.0
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Internal flag: run the tick loop inside the FastAPI process ("1").
TICK_LOOP_IN_PROCESS=

# =============================================================================
# 6. CROWD CONVICTION FEEDS — fomo.fun board (crowd_heat real source)
# Optional — empty/unreachable feed degrades crowd_heat to the presence
# proxy. Fill these to get REAL conviction data like omotrades reads.
#
# 6a. FOMO PRIVY REFRESH TOKEN — log into https://fomo.family once -> F12 ->
# Application -> Local Storage -> https://fomo.family -> copy the Privy
# refresh token value (key looks like privy-refresh-token / privy-token).
FOMO_PRIVY_REFRESH_TOKEN=

# 6b. FIRECRAWL API KEY — REQUIRED with the FOMO token: prod-api.fomo.family
# Cloudflare-challenges direct reads, so reads are scraped through Firecrawl's
# stealth proxy (api.firecrawl.DEV — the old .app host is TLS-dead).
FIRECRAWL_API_KEY=

# 6c. STEALTH-SCRAPE FAILOVER (all optional) — when Firecrawl runs out of
# credits or errors, the next CONFIGURED provider below takes over
# automatically (exhausted providers are benched for 30 min). Fill at least
# one if you want credit-failover breadth.
SCRAPINGBEE_API_KEY=
SCRAPINGDOG_API_KEY=
ZENROWS_API_KEY=
SCRAPEOPS_API_KEY=

# (pump.fun comments were evaluated as a secondary source and DEFERRED —
# their API host is dead/503s even via stealth proxy; see docs/FOMO_INTEGRATION.md)

# =============================================================================
# 8. SUPABASE (Postgres) — optional remote DB backend.
# Empty = local SQLite at DB_PATH is used (current default behavior).
# To migrate: run migrations/supabase/001_init.sql in the Supabase SQL editor,
# then fill these in. SERVICE ROLE key bypasses RLS — server-side only,
# NEVER expose it to the frontend or commit it.
# =============================================================================
USE_SUPABASE_DB=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# =============================================================================
# 7. LIVE EXECUTION (real money — separate package, ships DISARMED)
# Nothing here is needed for the paper bot. Only touch if you deliberately
# want to prepare live_execution (still gated by hardcoded
# LIVE_TRADING_ENABLED=False in live_execution/config.py).
# =============================================================================
WALLET_KEYPAIR_PATH=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LIVE_EXECUTION_STATE_DIR=

# --- omo-parity additions (2026-08-25) -------------------------------------
# LLM output ceiling for qwen think/narrate (default 512, -1 = unlimited)
OLLAMA_NUM_PREDICT=512
# Second-pass cross-pool deep-research budget per tick (Dexscreener tokens API)
RESEARCH_PER_TICK=8
# LIVE EXECUTION (live_execution/ - DISARMED until a human edits its config.py):
SOLANA_RPC_URL=
EXPECTED_WALLET_ADDRESS=

# Realtime social read (provider-agnostic OpenAI-compatible). Empty key = off.
# Groq today:
SOCIAL_LLM_BASE_URL=https://api.groq.com/openai/v1
SOCIAL_LLM_API_KEY=
SOCIAL_LLM_MODEL=qwen/qwen3.8-27b
# Grok tomorrow - ONLY these three lines change:
# SOCIAL_LLM_BASE_URL=https://api.x.ai/v1
# SOCIAL_LLM_MODEL=grok-3-mini
SOCIAL_READ_PER_TICK=8
