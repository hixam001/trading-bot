# =============================================================================
# .env.example — EVERY environment field the application reads, by section.
# Copy to .env and fill in the values. "MUST FILL" = the feature it powers is
# off/broken without it. Risk-critical constants (PAPER_TRADING_ONLY,
# SLIPPAGE_PCT, FEE_PCT, all rule/exit thresholds) are HARDCODED in config.py
# and deliberately NOT here.
# =============================================================================

# --- 1. CORE (must review) ----------------------------------------------------
# Data backend selection: "mock" | "live". MUST BE SET — "live" additionally
# requires BIRDEYE_API_KEY below.
DATA_BACKEND=mock
# Where the SQLite book lives (relative paths resolve against the repo root).
DB_PATH=trading_bot.db

# --- 2. EXTERNAL API KEYS (fill per feature) ----------------------------------
# Birdeye: MUST FILL for DATA_BACKEND=live. Free key from birdeye.so
# (sent as X-API-KEY).
BIRDEYE_API_KEY=
# Dexscreener: OPTIONAL — basic endpoints are currently keyless; reserved for
# a future paid tier (sent as bearer token when set).
DEXSCREENER_API_KEY=
# Jupiter: OPTIONAL — quote API is currently keyless; Pro key sent as
# x-api-key when set.
JUPITER_API_KEY=

# --- 3. MAIN LLM (used for thesis and model analysis) ------------------------
# Provider selector for the MAIN path (thinker / narrator / reflections):
# "groq" | "deepseek" (default groq). Reversible flip; Groq stays the warm
# rollback path. The social read below is NOT affected by this flag.
MAIN_LLM_PROVIDER=groq

# --- 3a. Groq (main provider today; warm rollback) ---------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_TOKENS=192

# --- 3b. DeepSeek direct API (main-provider candidate, docs/08) --------------
# Non-thinking mode only. MUST FILL DEEPSEEK_API_KEY before setting
# MAIN_LLM_PROVIDER=deepseek; without a key the main path degrades
# fail-closed to template passes (never a buy).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=12
DEEPSEEK_MAX_TOKENS=192

# Legacy local provider settings, retained for offline compatibility only.
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3:8b
# Optional: context window for generate calls (KV-cache RAM scales with it).
OLLAMA_NUM_CTX=1024

# --- 4. TICK LOOP (optional tuning; defaults shown) ---------------------------
TICK_INTERVAL_SECONDS=60
MAX_CANDIDATES_PER_TICK=20

# --- 5. PORTFOLIO & API SERVER (optional tuning; defaults shown) --------------
INITIAL_CASH_USD=1000.0
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Internal flag: run the tick loop inside the FastAPI process ("1").
TICK_LOOP_IN_PROCESS=

# =============================================================================
# 6. CROWD CONVICTION FEEDS — fomo.fun board (crowd_heat real source)
# Optional — empty/unreachable feed degrades crowd_heat to the presence
# proxy. Fill these to get REAL conviction data like the reference bot reads.
#
# 6a. FOMO PRIVY REFRESH TOKEN — log into https://fomo.family once -> F12 ->
# Application -> Local Storage -> https://fomo.family -> copy the Privy
# refresh token value (key looks like privy-refresh-token / privy-token).
FOMO_PRIVY_REFRESH_TOKEN=
# §54: the rotated-token sidecar (.fomo_privy.json) is Fernet-ENCRYPTED at
# rest. The key auto-generates on first run at SECRET_STORE_KEY_FILE (mode
# 600, gitignored). For file-less hosts (PaaS), set SECRET_STORE_KEY to a
# generated key instead:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_STORE_KEY=
SECRET_STORE_KEY_FILE=

# 6b. FIRECRAWL API KEY — §47 made the crowd feed FREE (local Scrapling
# transport, 100% pass rate); this key now funds ONLY the web-search
# evidence stage, and even there (§51) it is the LAST-resort failover
# behind Brave + self-hosted SearXNG. Empty = free transports only.
# (api.firecrawl.DEV — the old .app host is TLS-dead.)
FIRECRAWL_API_KEY=

# 6c. STEALTH-SCRAPE FAILOVER (all optional) — when Firecrawl runs out of
# credits or errors, the next CONFIGURED provider below takes over
# automatically. A provider that reports OUT OF CREDITS (HTTP 402) is benched
# for STEALTH_BENCH_SECONDS; one that is merely RATE-LIMITED (HTTP 429) gets a
# short STEALTH_THROTTLE_BACKOFF_SECONDS backoff instead, so a healthy provider
# isn't sidelined for 30 min over a transient throttle. Fill at least one if
# you want credit-failover breadth.
SCRAPINGBEE_API_KEY=
SCRAPINGDOG_API_KEY=
ZENROWS_API_KEY=
SCRAPEOPS_API_KEY=
# Long bench for a credit-exhausted (402) provider, seconds (default 1800=30m).
STEALTH_BENCH_SECONDS=1800
# Short backoff for a rate-limited (429) provider, seconds (default 75).
STEALTH_THROTTLE_BACKOFF_SECONDS=75

# 6d. §47 LOCAL STEALTH TRANSPORT (Scrapling — free, no keys). The crowd
# feed's direct read is now curl-cffi Chrome-TLS impersonated (Phase-0
# drill: 100% pass, no browser, no credits), with the local patchright
# stealth browser as the first fallback hop; the paid providers above stay
# as final failover. SCRAPLING_ENABLED=0 reverts to the pre-§47 paid chain.
SCRAPLING_ENABLED=1
# Browser-hop budget in milliseconds (default 30000).
SCRAPLING_TIMEOUT_MS=30000
# Close the warm browser after this many idle seconds (default 600).
SCRAPLING_IDLE_CLOSE_SECONDS=600
# Only if a deployment IP is hard-blocked: proxy for the browser hop
# (user:pass@host:port). Empty = never used.
SCRAPLING_PROXY=

# (pump.fun comments were evaluated as a secondary source and DEFERRED —
# their API host is dead/503s even via stealth proxy; see docs/FOMO_INTEGRATION.md)

# =============================================================================
# 8. SUPABASE (Postgres) — optional remote DB backend.
# Empty = local SQLite at DB_PATH is used (current default behavior).
# To migrate: run migrations/supabase/001_init.sql in the Supabase SQL editor,
# then fill these in. SERVICE ROLE key bypasses RLS — server-side only,
# NEVER expose it to the frontend or commit it.
# =============================================================================
USE_SUPABASE_DB=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# =============================================================================
# 7. LIVE EXECUTION (real money — now a subpackage INSIDE backend/, still
# gated by the hardcoded LIVE_TRADING_ENABLED flag in
# backend/live_execution/config.py — human-edit-only, never env).
# Nothing here is needed unless you deliberately run the live engine.
# =============================================================================
# Live state paths (kill switch, breaker, idempotency ledger, commit log,
# operator break). Defaults put everything in backend/live_execution/state/;
# override BOTH consistently if you relocate state (e.g. onto a mounted
# volume), and never hand-edit paths in code — a split state directory means
# an operator-tripped kill switch nothing reads.
LIVE_EXECUTION_STATE_DIR=
LIVE_STATE_DIR=
# Individual overrides (rarely needed; default inside LIVE_STATE_DIR):
BREAK_STATE_FILE=
KILL_SWITCH_FILE=
#
# Wallet secret: set exactly ONE of the two channels.
#   WALLET_KEYPAIR_PATH — preferred: a chmod-600 JSON byte-array file OUTSIDE
#                         the repo (on a VM, bind-mount it read-only into the
#                         container, e.g. /run/secrets/wallet_keypair).
#   WALLET_KEYPAIR_JSON — the keypair JSON direct in the env, for hosts that
#                         cannot mount files (PaaS). Parsed in-memory; never
#                         written to disk, never logged.
# With NEITHER set the wallet fails closed and nothing real-money can start.
# ALWAYS also pin EXPECTED_WALLET_ADDRESS — the loaded keypair must derive
# exactly that pubkey or every load refuses.
WALLET_KEYPAIR_PATH=
WALLET_KEYPAIR_JSON=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LIVE_EXECUTION_STATE_DIR=

# --- reference-parity additions (2026-08-25) -------------------------------------
# LLM output ceiling for qwen think/narrate (default 512, -1 = unlimited)
OLLAMA_NUM_PREDICT=512
# Second-pass cross-pool deep-research budget per tick (Dexscreener tokens API)
RESEARCH_PER_TICK=8
# LIVE EXECUTION (live_execution/ - DISARMED until a human edits its config.py):
SOLANA_RPC_URL=
EXPECTED_WALLET_ADDRESS=

# Realtime social read (provider-agnostic OpenAI-compatible). Empty key = off.
# §51: the read is STAGED — it runs inside the gate only for candidates that
# passed every rule, so the FREE Groq tier (1,000 requests/day) covers it.
# Groq free tier today:
SOCIAL_LLM_BASE_URL=https://api.groq.com/openai/v1
SOCIAL_LLM_API_KEY=
SOCIAL_LLM_MODEL=qwen/qwen3.8-27b
# Grok tomorrow - ONLY these three lines change:
# SOCIAL_LLM_BASE_URL=https://api.x.ai/v1
# SOCIAL_LLM_MODEL=grok-3-mini

# §48 — web-search evidence cache TTLs (the search itself is STAGED: it only
# runs for candidates that passed every rule, inside the gate). A HIT (real
# evidence) is cached this many seconds (default 7200 = 2h, well inside the
# search's own 24h window). A MISS (no results) is cached only the shorter
# window (default 1800 = 30m) so "nothing found" stays reasonably current.
WEB_SEARCH_CACHE_TTL=7200
WEB_SEARCH_CACHE_MISS_TTL=1800

# --- §51 FREE web-search transport chain (Brave → SearXNG → Firecrawl) ------
# The search stage prefers FREE transports; Firecrawl stays only as the
# last-resort paid failover. At least ONE of the three below = stage on.
#
# 51a. BRAVE SEARCH API — primary. Free key from
# https://api-dashboard.search.brave.com (free plan; $5 of credits is
# auto-applied every month ≈ 1,000 searches/month — comfortably above the
# staged stage's real volume since §48 cut it to all-passed candidates).
BRAVE_SEARCH_API_KEY=
# 51b. SELF-HOSTED SEARXNG — keyless secondary, unlimited. Runs as the
# compose sidecar (docker-compose.yml service "searxng"); point the engine
# at it INSIDE the docker network. Empty = hop off. PUBLIC instances do
# NOT work (they disable format=json → 403) — use the sidecar.
# On the compose network:      SEARXNG_URL=http://searxng:8080
# Bare-metal / manual run:     SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_URL=
# 51c. Bench semantics for the chain (crowd §34 style): a hop that reports
# credit/quota exhaustion (402/422) is benched this long (default 1800s);
# a rate-limited hop (429) gets the short backoff instead (default 75s).
SEARCH_BENCH_SECONDS=1800
SEARCH_THROTTLE_BACKOFF_SECONDS=75

# =============================================================================
# 9. OPERATOR API AUTH (§38 security audit)
# Gates the mutating operator endpoints (POST /api/admin/reset,
# POST /api/knowledge-base/ingest) via the X-Admin-Token header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# FAIL CLOSED: leave empty and those endpoints are DISABLED entirely (403).
# =============================================================================
ADMIN_TOKEN=
# Hard cap on one ingested knowledge document, characters (default 200000).
MAX_INGEST_CHARS=200000

SOCIAL_READ_PER_TICK=8
