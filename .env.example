# ─── trading-bot environment configuration — EXAMPLE ─────────────────────────
# Copy this file to .env and fill in your values.
# The real .env is gitignored and must never be committed.

OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3:8b

DATA_BACKEND=mock

BIRDEYE_API_KEY=your_birdeye_api_key_here

# ─── CoinStats API ───────────────────────────────────────────────────────────
# Backend is a stub (NotImplementedError) until field mapping is verified.
# Add your key here when implementing the coinstats backend.
COINSTATS_API_KEY=your_coinstats_api_key_here

# ─── Jupiter API (Optional) ──────────────────────────────────────────────────
# Jupiter quote API can be used without a key, but a key is recommended
# for higher rate limits.
JUPITER_API_KEY=your_jupiter_api_key_here

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

DB_PATH=trading_bot.db

INITIAL_CASH_USD=1000.0
POSITION_SIZE_PCT=0.10
MAX_OPEN_POSITIONS=5
TICK_INTERVAL_SECONDS=60
MAX_CANDIDATES_PER_TICK=20

# WALLET_PRIVATE_KEY=  (future analytics only — never used for execution)
# WALLET_PUBLIC_KEY=
