# =============================================================================
# .env.example — EVERY environment field the application reads, by section.
# Copy to .env and fill in the values. "MUST FILL" = the feature it powers is
# off/broken without it. Risk-critical constants (PAPER_TRADING_ONLY,
# SLIPPAGE_PCT, FEE_PCT, all rule/exit thresholds) are HARDCODED in config.py
# and deliberately NOT here.
# =============================================================================

# --- 1. CORE (must review) ----------------------------------------------------
# Data backend selection: "mock" | "live". MUST BE SET — "live" additionally
# requires BIRDEYE_API_KEY below.
DATA_BACKEND=mock
# Where the SQLite book lives (relative paths resolve against the repo root).
DB_PATH=trading_bot.db

# --- 2. EXTERNAL API KEYS (fill per feature) ----------------------------------
# Birdeye: MUST FILL for DATA_BACKEND=live. Free key from birdeye.so
# (sent as X-API-KEY).
BIRDEYE_API_KEY=
# Dexscreener: OPTIONAL — basic endpoints are currently keyless; reserved for
# a future paid tier (sent as bearer token when set).
DEXSCREENER_API_KEY=
# Jupiter: OPTIONAL — quote API is currently keyless; Pro key sent as
# x-api-key when set.
JUPITER_API_KEY=

# --- 3. LLM / OLLAMA (must have Ollama running for live narration) ------------
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3:8b
# Optional: context window for generate calls (KV-cache RAM scales with it).
OLLAMA_NUM_CTX=1024

# --- 4. TICK LOOP (optional tuning; defaults shown) ---------------------------
TICK_INTERVAL_SECONDS=60
MAX_CANDIDATES_PER_TICK=20

# --- 5. PORTFOLIO & API SERVER (optional tuning; defaults shown) --------------
INITIAL_CASH_USD=1000.0
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Internal flag: run the tick loop inside the FastAPI process ("1").
TICK_LOOP_IN_PROCESS=

# =============================================================================
# 6. CROWD CONVICTION FEEDS (crowd_heat real sources)
# All optional — empty/unreachable feeds degrade crowd_heat to the presence
# proxy. Fill these to get REAL conviction data like omotrades reads.
# =============================================================================

# 6a. FOMO BOARD — MUST FILL for real fomo.fun conviction.
# How to get it: log into https://fomo.family once -> F12 (DevTools) ->
# Application -> Local Storage -> https://fomo.family -> copy the Privy
# refresh token value (key looks like privy-refresh-token / privy-token).
FOMO_PRIVY_REFRESH_TOKEN=

# 6b. FIRECRAWL — MUST FILL for the FOMO board above: prod-api.fomo.family
# Cloudflare-challenges direct reads (verified), so reads are scraped through
# Firecrawl's stealth proxy. Free key at firecrawl.dev.
FIRECRAWL_API_KEY=

# 6c. PUMP.FUN COMMENTS — refresh token + comments route needed (the app id
# is already hardcoded as pump.fun's public id).
# refresh token: log into https://pump.fun -> F12 -> Application ->
# Local Storage -> https://pump.fun -> key "privy:refresh_token" -> copy value.
PUMPFUN_PRIVY_REFRESH_TOKEN=
# comments route: F12 -> Network on any pump.fun coin page -> find the XHR
# that loads comments -> copy its URL, replacing the mint with {mint}.
PUMPFUN_COMMENTS_URL_TEMPLATE=https://advanced-api-v2.pump.fun/replies/coins/{mint}?limit=20&offset=0

# =============================================================================
# 7. LIVE EXECUTION (real money — separate package, ships DISARMED)
# Nothing here is needed for the paper bot. Only touch if you deliberately
# want to prepare live_execution (still gated by hardcoded
# LIVE_TRADING_ENABLED=False in live_execution/config.py).
# =============================================================================
WALLET_KEYPAIR_PATH=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LIVE_EXECUTION_STATE_DIR=
