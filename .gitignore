# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local state
*.db
*.db-journal
*.db-wal
*.db-shm
.env
# Env-file variants: `.env` (above) matches the exact name only. `.env.*`
# covers Vite's .env.local (which frontend/.env.example tells the operator
# to create — highest-priority env file), .env.*.local convention files,
# and editor droppings (.env.bak/.env.backup/.env.save). Slash-free patterns
# apply at every depth, so one rule covers root AND frontend/. Examples
# stay tracked via the negation below.
.env.*
!.env.example
# Secret material wherever it lands: docker-compose documents ./secrets/ as
# the keypair mount dir; key/cert extensions are belt-and-braces.
secrets/
*.pem
*.key
*.keypair
*.p12
*.pfx
id_rsa
id_rsa.*
.fomo_privy.json
.supabase_fp.txt
blocklist_state.json
backend/live_execution/state/
wallet-keypair.json
# Live execution ledgers (real order nonces) — never commit, wherever they land
commits.json
# Operator-ingested knowledge archive (runtime data, not code)
backend/knowledge_base/ingested/

# Frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# Playwright
frontend/test-results/
frontend/playwright-report/

# Third-party Cline skills marketplace install (own .git, 22MB of example
# images) — local tooling, not project content. Its design guidance was
# synthesized into frontend/DESIGN.md, the UI source of truth.
.clinerules/awesome-design-skills/


# One-click launcher state
.run/
logs/
